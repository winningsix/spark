+package org.apache.spark.sql.execution.adaptive
+
+import java.nio.file.Paths
+import scala.jdk.CollectionConverters._
+import com.fasterxml.jackson.databind.ObjectMapper
+import org.apache.spark.shuffle.streaming.MapBatchPartitioner
+import org.apache.spark.sql.classic.SparkSession
+import org.apache.spark.sql.execution.exchange.ShuffleExchangeExec
+import org.apache.spark.util.Utils
+
+object WindowMergeFrameCheck extends AdaptiveSparkPlanHelper {
+  def main(args: Array[String]): Unit = {
+    val builder = SparkSession.builder().master("local-cluster[2,8,1024]").appName("framed window aggregate")
+    new ObjectMapper().readTree(Paths.get(args(0)).toFile).fields().asScala
+      .foreach(entry => builder.config(entry.getKey, entry.getValue.asText))
+    val s = builder.config("spark.executor.memory", "768m")
+      .config("spark.executor.extraClassPath", System.getProperty("java.class.path"))
+      .config("spark.executor.extraJavaOptions", "-XX:ActiveProcessorCount=4")
+      .config("spark.ui.enabled", false)
+      .config("spark.sql.shuffle.partitions", 17)
+      .config("spark.sql.files.minPartitionNum", 4)
+      .getOrCreate()
+    val dir = Utils.createTempDir()
+    try {
+      val dest=new java.io.File(dir,"input").getPath
+      s.sql("""select if(id%191=0,null,id%23) shop, id%97 item,
+        cast(if(id%37=0,null,id%53-27) as decimal(9,2)) price from range(0,120000,1,8)""")
+        .write.parquet(dest)
+      s.read.parquet(dest).createOrReplaceTempView("sales")
+      def run(live: Boolean, mean: Boolean) = {
+        s.conf.set("spark.sql.shuffle.distributedPipelined.enabled", live)
+        val fun=if (mean) "avg" else "max"
+        val df=s.sql(s"""select shop,item,total,$fun(total) over (partition by shop) window_value
+          from (select shop,item,sum(price) total from sales group by shop,item)""")
+        val rows=df.collect().map(_.toString).sorted.toList
+        val aqe=df.queryExecution.executedPlan.asInstanceOf[AdaptiveSparkPlanExec]
+        val framed=collect(aqe){case e:ShuffleExchangeExec if e.pipelined &&
+          e.shuffleDependency.partitioner.isInstanceOf[MapBatchPartitioner]=>e}
+        require(framed.size==(if(live && mean) 1 else 0),aqe.treeString)
+        println(s"CHECK live=$live mean=$mean rows=${rows.size} framed=${framed.size}")
+        (df.schema,rows)
+      }
+      for (mean<-Seq(true,false)) require(run(false,mean)==run(true,mean))
+      println("PASS distributed framed window merge")
+    } finally {
+      s.stop()
+      Utils.deleteRecursively(dir)
+    }
+  }
+}
