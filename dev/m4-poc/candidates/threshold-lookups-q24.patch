+package org.apache.spark.sql.execution.adaptive
+
+import org.apache.spark.sql.catalyst.expressions._
+import org.apache.spark.sql.catalyst.expressions.aggregate.{AggregateExpression, Average, Complete, Max, Sum}
+import org.apache.spark.sql.catalyst.plans.logical._
+import org.apache.spark.sql.catalyst.rules.Rule
+import org.apache.spark.sql.types.{ByteType, NumericType}
+
+/** Compute a global average and the selected groups' sums from one read of a grouped CTE. */
+private[sql] object SinglePassGroupThreshold extends Rule[LogicalPlan] {
+  val thresholdMetadata = "org.apache.spark.sql.singlePassThreshold"
+  private def bare(p: LogicalPlan): LogicalPlan = p match {
+    case SubqueryAlias(_,c) => bare(c)
+    case Project(cols,c) if cols.forall(_.isInstanceOf[Attribute]) => bare(c)
+    case _ => p
+  }
+
+  private def rewrite(f: Filter, d: CTERelationDef): Option[LogicalPlan] = for {
+    a <- Some(bare(f.child)).collect { case g:Aggregate => g }
+    keys = a.groupingExpressions.collect { case k:Attribute=>k }
+    if keys.nonEmpty && keys.size==a.groupingExpressions.size && keys.distinct.size==keys.size
+    if a.aggregateExpressions.forall {
+      case k:Attribute => keys.exists(_.semanticEquals(k))
+      case Alias(AggregateExpression(Sum(_:Attribute,_),Complete,false,None,_),_) => true
+      case _ => false
+    }
+    keep <- Some(bare(a.child)).collect { case v:Filter if v.condition.deterministic=>v }
+    used <- Some(bare(keep.child)).collect { case r:CTERelationRef if r.cteId==d.id=>r }
+    if keep.condition.references.subsetOf(used.outputSet) && a.references.subsetOf(used.outputSet)
+    scalar <- f.condition.collect { case s:ScalarSubquery=>s } match {
+      case Seq(s) if !s.isCorrelated && s.hint.isEmpty => Some(s)
+      case _ => None
+    }
+    global <- Some(bare(scalar.plan)).collect {case g:Aggregate if g.groupingExpressions.isEmpty=>g}
+    value <- global.aggregateExpressions match {
+      case Seq(alias:Alias) if alias.deterministic && alias.dataType.isInstanceOf[NumericType] &&
+          alias.collect {case ae:AggregateExpression=>ae}.size==1 && alias.exists {
+            case AggregateExpression(Average(_:Attribute,_),Complete,false,None,_)=>true
+            case _=>false
+          } => Some(alias.child)
+      case _=>None
+    }
+    other <- Some(bare(global.child)).collect {case r:CTERelationRef if r.cteId==d.id=>r}
+    if used.output.map(_.dataType)==other.output.map(_.dataType) && value.references.subsetOf(other.outputSet)
+    if f.outputSet.subsetOf(a.outputSet)
+  } yield {
+    val lane=AttributeReference("threshold_group",ByteType,nullable=false,
+      metadata=new org.apache.spark.sql.types.MetadataBuilder().putBoolean(thresholdMetadata,true).build())()
+    val total=Literal(0.toByte);val detail=Literal(1.toByte)
+    val grouped=keys.map(k=>k.newInstance().withNullability(true))
+    val expanded=Expand(Seq(used.output ++ keys.map(k=>Literal.create(null,k.dataType)) :+ total,
+      used.output ++ keys :+ detail),used.output ++ grouped :+ lane,used)
+    val isTotal=EqualTo(lane,total);val isDetail=EqualTo(lane,detail)
+    val filtered=Filter(Or(isTotal,keep.condition),expanded)
+    val groups=AttributeMap(keys.zip(grouped))
+    val columns=a.aggregateExpressions.map {
+      case k:Attribute=>Alias(groups(k),k.name)(k.exprId,k.qualifier,Some(k.metadata))
+      case n=>n.transformDown {case ae:AggregateExpression=>ae.copy(filter=Some(isDetail))}
+        .asInstanceOf[NamedExpression]
+    }
+    val mapping=AttributeMap(other.output.zip(used.output))
+    val avg=value.transformUp {
+      case k:Attribute=>mapping(k)
+      case ae:AggregateExpression=>ae.copy(filter=Some(isTotal))
+    }
+    val threshold=Alias(avg,"all_group_threshold")()
+    val agg=Aggregate(grouped :+ lane,(columns :+ lane) :+ threshold,filtered)
+    val frame=WindowSpecDefinition(Nil,Nil,SpecifiedWindowFrame(RowFrame,UnboundedPreceding,UnboundedFollowing))
+    // Only the one global row contributes. Ordinary groups maintain their original SUM buffers.
+    val cell=If(isTotal,threshold.toAttribute,Literal.create(null,threshold.dataType))
+    val shared=Alias(WindowExpression(Max(cell).toAggregateExpression(),frame),"shared_group_threshold")()
+    val annotated=Window(Seq(shared),Nil,Nil,agg)
+    val having=f.condition.transformDown {case x:ScalarSubquery if x.exprId==scalar.exprId=>shared.toAttribute}
+    Project(f.output,Filter(And(isDetail,having),annotated))
+  }
+
+  override def apply(input: LogicalPlan): LogicalPlan = input match {
+    case w:WithCTE if input.resolved && !input.isStreaming &&
+        conf.getConfString(CommonGroupThreshold.setting,"keyed")=="keyed" =>
+      val changed=w.cteDefs.filter(d=>d.materialized.isEmpty && d.child.deterministic &&
+        bare(d.child).isInstanceOf[Aggregate] && w.plan.collectWithSubqueries {
+          case r:CTERelationRef if r.cteId==d.id=>r
+        }.size==2).foldLeft(w.plan) { (p,d)=>
+          p.resolveOperatorsUp {case f:Filter=>rewrite(f,d).getOrElse(f)}
+        }
+      if (changed.fastEquals(w.plan)) w else w.copy(plan=changed)
+    case p=>p
+  }
+}
