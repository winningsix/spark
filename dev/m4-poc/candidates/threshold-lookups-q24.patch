+package org.apache.spark.sql.execution.adaptive
+
+import org.apache.spark.sql.catalyst.expressions._
+import org.apache.spark.sql.catalyst.plans.Inner
+import org.apache.spark.sql.catalyst.plans.logical._
+import org.apache.spark.sql.catalyst.rules.Rule
+import org.apache.spark.sql.execution.datasources.LogicalRelation
+import org.apache.spark.sql.types.StringType
+
+/** Join two related dimensions with their common lookup before shuffling the facts.
+ * Only flatten attribute projections and deterministic, unhinted inner equijoins.
+ */
+private[adaptive] object JoinRelatedLookups extends Rule[LogicalPlan] with PredicateHelper {
+  private case class Chain(leaves: Vector[LogicalPlan], predicates: Vector[Expression])
+  private def scan(p: LogicalPlan): Boolean = p match {
+    case _: LogicalRelation => true
+    case Project(cols, child) if cols.forall(_.isInstanceOf[Attribute]) => scan(child)
+    case Filter(cond, child) if cond.deterministic => scan(child)
+    case _ => false
+  }
+
+  private def chain(p: LogicalPlan): Option[Chain] = p match {
+    case leaf if scan(leaf) => Some(Chain(Vector(leaf),Vector.empty))
+    case Project(cols, child) if cols.forall(_.isInstanceOf[Attribute]) => chain(child)
+    case Join(l,r,Inner,Some(cond),JoinHint.NONE) if cond.deterministic &&
+        !SubqueryExpression.hasSubquery(cond) && scan(r) =>
+      chain(l).map(c => Chain(c.leaves :+ r, c.predicates ++ splitConjunctivePredicates(cond)))
+    case _ => None
+  }
+
+  private def matches(a: LogicalPlan,b: LogicalPlan,e: Expression): Boolean = e match {
+    case EqualTo(x: Attribute,y: Attribute) =>
+      (a.outputSet.contains(x) && b.outputSet.contains(y)) ||
+        (a.outputSet.contains(y) && b.outputSet.contains(x))
+    case _ => false
+  }
+
+  private def filteredLookup(p: LogicalPlan): Boolean = p.exists {
+    case Filter(c,_) => splitConjunctivePredicates(c).exists {
+      case EqualTo(_: Attribute, l: Literal) => l.value != null
+      case EqualTo(l: Literal, _: Attribute) => l.value != null
+      case _ => false
+    }
+    case _ => false
+  }
+
+  private def reorder(j: Join): Option[LogicalPlan] = for {
+    c <- chain(j.left) if c.leaves.size >= 4 && c.leaves.size <= 8
+    if scan(j.right) && j.right.deterministic && j.condition.exists(_.deterministic)
+    if c.leaves.forall(_.deterministic) && !SubqueryExpression.hasSubquery(j.condition.get)
+    fact = c.leaves.head
+    dims = c.leaves.tail
+    closing = splitConjunctivePredicates(j.condition.get)
+    peers = dims.filter(d => closing.exists(matches(d,j.right,_)))
+    if peers.size == 2 && peers.forall(d => c.predicates.exists(matches(fact,d,_)))
+    small <- peers.find(d => filteredLookup(d) && closing.exists {
+      case e @ EqualTo(x: Attribute,_) => x.dataType == StringType && matches(d,j.right,e)
+      case _ => false
+    })
+    other = peers.find(_ ne small).get
+    if dims.exists(d => (d ne small) && (d ne other) && c.predicates.count(matches(fact,d,_)) >= 2)
+    rebuilt <- assemble(Vector(small,j.right,other,fact) ++ dims.filterNot(peers.contains),
+      c.predicates ++ closing)
+    if j.outputSet.subsetOf(rebuilt.outputSet)
+  } yield Project(j.output,rebuilt)
+
+  private def assemble(inputs: Vector[LogicalPlan], conditions: Seq[Expression]): Option[LogicalPlan] = {
+    var result = inputs.head
+    var remaining = conditions
+    for (next <- inputs.tail) {
+      val available = result.outputSet ++ next.outputSet
+      val (ready,later) = remaining.partition(_.references.subsetOf(available))
+      if (!ready.exists(matches(result,next,_))) return None
+      result = Join(result,next,Inner,Some(ready.reduceLeft(And)),JoinHint.NONE)
+      remaining = later
+    }
+    Option.when(remaining.isEmpty)(result)
+  }
+
+  override def apply(plan: LogicalPlan): LogicalPlan = {
+    if (!plan.resolved || plan.isStreaming) return plan
+    plan.transformUp {
+      case j @ Join(_,_,Inner,Some(_),JoinHint.NONE) => reorder(j).getOrElse(j)
+    }
+  }
+}
