+package org.apache.spark.sql.execution.adaptive
+
+import org.apache.spark.sql.catalyst.expressions._
+import org.apache.spark.sql.catalyst.plans.logical.{Aggregate, LogicalPlan}
+import org.apache.spark.sql.catalyst.rules.Rule
+import org.apache.spark.sql.types.{Decimal, DecimalType}
+
+/** Evaluate exact sums and differences of fixed-scale inputs before division by two. */
+private[adaptive] object FixedDecimalHalf extends Rule[LogicalPlan] {
+  private case class Fixed(value: Expression, scale: Int, magnitude: BigInt)
+
+  private def fixed(e: Expression): Option[Fixed] = (e, e.dataType) match {
+    case (a: Attribute, t: DecimalType) if t.precision <= 18 && t.scale >= 0 =>
+      Some(Fixed(UnscaledValue(a), t.scale, BigInt(10).pow(t.precision) - 1))
+    case (b: BinaryArithmetic, t: DecimalType) if b.isInstanceOf[Add] || b.isInstanceOf[Subtract] =>
+      for {
+        l <- fixed(b.left)
+        r <- fixed(b.right)
+        if l.scale == r.scale && l.scale == t.scale
+        bound = l.magnitude + r.magnitude
+        if bound <= Long.MaxValue && bound < BigInt(10).pow(t.precision)
+      } yield Fixed(b.withNewChildren(Seq(l.value, r.value)), t.scale, bound)
+    case _ => None
+  }
+
+  private def half(d: Divide): Option[Expression] = for {
+    t <- Option(d.dataType).collect { case dec: DecimalType => dec }
+    if (d.right match {
+      case Literal(n: Decimal, _) => n.toJavaBigDecimal.compareTo(java.math.BigDecimal.valueOf(2L)) == 0
+      case _ => false
+    })
+    if d.left.isInstanceOf[Add] || d.left.isInstanceOf[Subtract]
+    n <- fixed(d.left)
+    scale = n.scale + 1
+    bound = n.magnitude * 5
+    precision = math.max(scale, bound.toString.length)
+    if precision <= 18 && scale <= t.scale && precision - scale <= t.precision - t.scale
+  } yield Cast(MakeDecimal(Multiply(n.value, Literal(5L)), precision, scale, false), t)
+
+  override def apply(plan: LogicalPlan): LogicalPlan = plan.transformUp {
+    case a: Aggregate if !a.isStreaming =>
+      a.transformExpressionsUp { case d: Divide => half(d).getOrElse(d) }
+  }
+}
