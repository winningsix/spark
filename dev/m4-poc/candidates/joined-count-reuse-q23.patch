+package org.apache.spark.sql.execution.adaptive
+
+import org.apache.spark.sql.catalyst.expressions.SortOrder
+import org.apache.spark.sql.catalyst.optimizer.{BuildLeft, BuildRight, JoinSelectionHelper}
+import org.apache.spark.sql.catalyst.plans.{Inner, LeftSemi}
+import org.apache.spark.sql.catalyst.plans.logical.{Join, SHUFFLE_MERGE}
+import org.apache.spark.sql.execution.{CoalescedPartitionSpec, SortExec, SparkPlan}
+import org.apache.spark.sql.execution.exchange.{ENSURE_REQUIREMENTS, REBALANCE_PARTITIONS_BY_COL, ShuffleOrigin}
+import org.apache.spark.sql.execution.joins.{BroadcastHashJoinExec, HashJoin, ShuffledHashJoinExec, SortMergeJoinExec}
+import org.apache.spark.sql.internal.SQLConf
+
+/** A broadcast semi join can only remove rows from its streamed partition.
+ * Use the measured input size as a bound for picking the smaller hash build
+ * after AQE has assigned the final coalesced partitions.
+ */
+private[adaptive] object FilteredPartitionHashJoin extends AQEShuffleReadRule
+  with JoinSelectionHelper {
+  override protected def supportedShuffleOrigins: Seq[ShuffleOrigin] = Seq(ENSURE_REQUIREMENTS, REBALANCE_PARTITIONS_BY_COL)
+
+  private case class Input(plan: SparkPlan, peakBytes: Long, filteredLookup: Boolean)
+
+  private def measuredInput(sort: SparkPlan): Option[Input] = sort match {
+    case SortExec(_, false, child, _) =>
+      val streamed = child match {
+        case semi: BroadcastHashJoinExec if semi.joinType == LeftSemi && semi.buildSide == BuildRight =>
+          semi.left
+        case other => other
+      }
+      streamed match {
+        case AQEShuffleReadExec(stage: ShuffleQueryStageExec, specs)
+            if isSupported(stage.shuffle) && stage.isMaterialized =>
+          val sizes = specs.collect { case p: CoalescedPartitionSpec => p.dataSize }.flatten
+          val stagedMembership = stage.shuffle.shuffleOrigin == REBALANCE_PARTITIONS_BY_COL &&
+            stage.shuffle.child.exists {
+              case h: HashJoin => h.joinType == LeftSemi
+              case _ => false
+            }
+          val filtered = (streamed ne child) || stagedMembership
+          if (sizes.size == specs.size && sizes.forall(_ >= 0)) Some(Input(child, sizes.max, filtered))
+          else None
+        case _ => None
+      }
+    case _ => None
+  }
+
+  private def choose(join: SortMergeJoinExec): SparkPlan = {
+    val candidate = for {
+      left <- measuredInput(join.left)
+      right <- measuredInput(join.right)
+      if left.filteredLookup || right.filteredLookup
+      if math.min(left.peakBytes, right.peakBytes) <= conf.getConf(SQLConf.ADVISORY_PARTITION_SIZE_IN_BYTES)
+      if join.leftKeys.forall(_.references.subsetOf(left.plan.outputSet)) &&
+        join.rightKeys.forall(_.references.subsetOf(right.plan.outputSet))
+    } yield {
+      val side = if (right.peakBytes <= left.peakBytes) BuildRight else BuildLeft
+      val converted = ShuffledHashJoinExec(join.leftKeys, join.rightKeys, join.joinType,
+        side, join.condition, left.plan, right.plan)
+      converted.copyTagsFrom(join)
+      converted
+    }
+    candidate.getOrElse(join)
+  }
+
+  override def apply(plan: SparkPlan): SparkPlan = {
+    val respectMerge = plan.exists(_.logicalLink.exists {
+      case j: Join => Seq(j.hint.leftHint, j.hint.rightHint).flatten.exists(_.strategy.contains(SHUFFLE_MERGE))
+      case _ => false
+    })
+    if (respectMerge || plan.exists(_.logicalLink.exists(_.isStreaming))) return plan
+    val candidate = plan.transformUp {
+      case join: SortMergeJoinExec if !join.isSkewJoin && join.joinType == Inner &&
+          hashJoinSupported(join.leftKeys, join.rightKeys) => choose(join)
+    }
+    if (SortOrder.orderingSatisfies(candidate.outputOrdering, plan.outputOrdering)) candidate else plan
+  }
+}
