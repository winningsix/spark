+package org.apache.spark.sql.execution.adaptive
+
+import org.apache.spark.sql.catalyst.expressions._
+import org.apache.spark.sql.types.{DecimalType, LongType}
+
+/** Use unscaled multiplication when the input values fit a Long and Spark keeps the exact scale. */
+private[adaptive] object GuardedIntegralProduct {
+  private def compact(m: Multiply, cast: Cast, price: Attribute): Option[Expression] = for {
+    quantity <- Option(cast.child).collect {case a: Attribute if a.dataType == LongType => a}
+    whole <- Option(cast.dataType).collect {case d: DecimalType if d.scale == 0 && d.precision >= 19 => d}
+    amount <- Option(price.dataType).collect {case d: DecimalType if d.scale >= 0 && d.precision <= 18 => d}
+    result <- Option(m.dataType).collect {case d: DecimalType if d.scale == amount.scale &&
+        d.precision >= 19 + amount.precision => d}
+  } yield {
+    val maxPrice = BigInt(10).pow(amount.precision) - 1
+    val limit = (BigInt(Long.MaxValue) / maxPrice).toLong
+    val fits = And(GreaterThanOrEqual(quantity,Literal(-limit)),LessThanOrEqual(quantity,Literal(limit)))
+    val value = Multiply(quantity,UnscaledValue(price))
+    If(fits,MakeDecimal(value,result.precision,result.scale),m)
+  }
+
+  def apply(value: Expression): Expression = value match {
+    case m @ Multiply(c: Cast, p: Attribute, _) => compact(m,c,p).getOrElse(m)
+    case m @ Multiply(p: Attribute, c: Cast, _) => compact(m,c,p).getOrElse(m)
+    case other => other
+  }
+}
