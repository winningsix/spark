+package org.apache.spark.sql.execution.adaptive
+
+import org.apache.spark.sql.catalyst.expressions.{Attribute, EqualTo}
+import org.apache.spark.sql.catalyst.plans.{Inner, LeftSemi}
+import org.apache.spark.sql.catalyst.plans.logical._
+import org.apache.spark.sql.catalyst.rules.Rule
+
+/** An equijoin propagates membership across its key. Two identical semijoins
+ * on that key need only filter one input. Measure the filtered lookup before
+ * choosing how to join it with the fact rows.
+ */
+private[adaptive] object ShareJoinMembership extends Rule[LogicalPlan] {
+  private def equality(j: Join): Option[(Attribute, Attribute)] = j.condition match {
+    case Some(EqualTo(a: Attribute, b: Attribute)) =>
+      Seq((a,b),(b,a)).find { case (l,r) => j.left.outputSet.contains(l) && j.right.outputSet.contains(r) }
+    case _ => None
+  }
+
+  private def lookup(p: LogicalPlan): Boolean = p match {
+    case Project(columns, child) if columns.forall(_.isInstanceOf[Attribute]) => lookup(child)
+    case Filter(test, child) if test.deterministic && !test.exists(_.isInstanceOf[
+        org.apache.spark.sql.catalyst.expressions.SubqueryExpression]) => lookup(child)
+    case _: org.apache.spark.sql.execution.datasources.LogicalRelation => true
+    case _ => false
+  }
+
+  private def rewrite(parent: Join, l: Join, r: Join): Option[Join] = for {
+    (lk,rk) <- equality(parent)
+    (lf,lbuild) <- equality(l)
+    (rf,rbuild) <- equality(r)
+    if lk.semanticEquals(lf) && rk.semanticEquals(rf)
+    if l.right.output.size == 1 && r.right.output.size == 1 &&
+      lbuild.semanticEquals(l.right.output.head) && rbuild.semanticEquals(r.right.output.head)
+    if l.right.deterministic && r.right.deterministic && l.right.sameResult(r.right)
+    if lookup(l.left) != lookup(r.left)
+  } yield {
+    def measured(side: Join, key: Attribute) =
+      RebalancePartitions(Seq(key), side, Some(conf.numShufflePartitions))
+    if (lookup(r.left)) parent.copy(left=l.left,right=measured(r,rk))
+    else parent.copy(left=measured(l,lk),right=r.left)
+  }
+
+  override def apply(plan: LogicalPlan): LogicalPlan = {
+    if (plan.isStreaming || !conf.adaptiveExecutionEnabled) return plan
+    plan.transformUp {
+      case j @ Join(l: Join, r: Join, Inner, _, JoinHint.NONE)
+          if l.joinType == LeftSemi && r.joinType == LeftSemi &&
+            l.hint == JoinHint.NONE && r.hint == JoinHint.NONE =>
+        rewrite(j,l,r).getOrElse(j)
+    }
+  }
+}
